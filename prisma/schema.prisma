generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String? // 
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  location  String?
  jobTitle  String?
  timezone  String?   @default("UTC+3") // Zaman dilimi çok kritik!
  birthdate DateTime?
  phone     String?

  // --- İlişkiler ---
  createdProjects  Project[]         @relation("CreatedProjects") // Sahibi olduğu projeler
  reportedIssues   Issue[]           @relation("ReportedIssues") // Raporladığı görevler
  assignedIssues   Issue[]           @relation("AssignedIssues") // Kendisine atanan görevler
  projectsAsMember ProjectMember[]   @relation("ProjectsAsMember") // Üyesi olduğu projeler (ProjectMember tablosu üzerinden)
  comments         Comment[]
  favoriteProjects FavoriteProject[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token]) // Aynı email ve token ikilisi tekrar edemez
}

model Project {
  id          String   @id @default(cuid())
  projectName String
  projectKey  String   @unique // Proje anahtarı (benzersiz)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image String? // Proje resmi/ikonu
  icon  String? // Proje ikonu (emoji veya simge)
  color String? // Proje rengi (hex kodu) 

  // --- İlişkiler ---
  // Projeyi oluşturan kişi (Owner)
  ownerId String
  owner   User   @relation("CreatedProjects", fields: [ownerId], references: [id])

  // Projedeki üyeler (Çoktan-çoka)
  members    ProjectMember[]
  issueCount Int             @default(0)
  // Projedeki tüm görevler
  issues     Issue[]

  sprints     Sprint[]
  favoritedBy FavoriteProject[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER) // Enum ile rol yönetimi
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("ProjectsAsMember", fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade) // Proje silinirse üyelik de silinir

  // Bir kullanıcı bir projeye sadece bir kez üye olabilir
  @@unique([userId, projectId])
}

model FavoriteProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Bir kullanıcı aynı projeyi iki kere favorileyemesin diye:
  @@unique([userId, projectId])
}

model Issue {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  status      IssueStatus   @default(TODO) // Enum ile durum yönetimi
  priority    IssuePriority @default(MEDIUM) // Enum ile öncelik yönetimi
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Float         @default(0) // Sıralama için
  
  // 👇 YENİ EKLENENLER: Arayüzdeki yeni alanlar için
  dueDate     DateTime?     // Bitiş tarihi (Opsiyonel)
  storyPoints Int?          // Story Points / Puanlama (Opsiyonel)

  comments    Comment[]     // İlişki

  number    Int // Proje içindeki benzersiz görev numarası
  // --- İlişkiler ---
  
  // Görevin ait olduğu proje
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Görevi raporlayan/açan kişi
  reporterId String
  reporter   User   @relation("ReportedIssues", fields: [reporterId], references: [id])

  // Görevin atandığı kişi (opsiyonel, atanmamış olabilir)
  assigneeId String?
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id])
  
  sprint   Sprint? @relation(fields: [sprintId], references: [id])
  sprintId String?

  @@unique([projectId, number])
}

model Sprint {
  id        String       @id @default(cuid())
  name      String // Örn: "PLAN Sprint 1"
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PENDING) // PENDING, ACTIVE, COMPLETED

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues Issue[] // Bir sprinte bağlı görevler

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sprint durumları
enum SprintStatus {
  PENDING // Planlanan (Gelecek)
  ACTIVE // Şu an devam eden
  COMPLETED // Tamamlanan
}

// Projedeki kullanıcı rolleri
enum Role {
  OWNER
  ADMIN // Projeyi yönetebilir, üye ekleyip çıkarabilir
  MEMBER // Görev oluşturabilir, görevleri yönetebilir
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// Bir görevin durumu (Kanban board için)
enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// Bir görevin öncelik seviyesi
enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  HIGHEST
}
