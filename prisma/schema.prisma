generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String? // 
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdProjects  Project[]       @relation("CreatedProjects") // Sahibi olduğu projeler
  reportedIssues   Issue[]         @relation("ReportedIssues") // Raporladığı görevler
  assignedIssues   Issue[]         @relation("AssignedIssues") // Kendisine atanan görevler
  projectsAsMember ProjectMember[] @relation("ProjectsAsMember") // Üyesi olduğu projeler (ProjectMember tablosu üzerinden)
  comments         Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  projectName String
  projectKey  String   @unique // Jira'daki "KAN", "PROJ" gibi kısa kod
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- İlişkiler ---
  // Projeyi oluşturan kişi (Owner)
  ownerId String
  owner   User   @relation("CreatedProjects", fields: [ownerId], references: [id])

  // Projedeki üyeler (Çoktan-çoka)
  members    ProjectMember[]
  issueCount Int             @default(0)
  // Projedeki tüm görevler
  issues     Issue[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER) // Enum ile rol yönetimi
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("ProjectsAsMember", fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade) // Proje silinirse üyelik de silinir

  // Bir kullanıcı bir projeye sadece bir kez üye olabilir
  @@unique([userId, projectId])
}

model Issue {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  status      IssueStatus   @default(TODO) // Enum ile durum yönetimi
  priority    IssuePriority @default(MEDIUM) // Enum ile öncelik yönetimi
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Float         @default(0) // Sıralama için (Float kullanmak araya eklemeyi kolaylaştırır)
  comments    Comment[] // İlişki

  number    Int // Proje içindeki benzersiz görev numarası
  // --- İlişkiler ---
  // Görevin ait olduğu proje
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade) // Proje silinirse görevler de silinir

  // Görevi raporlayan/açan kişi
  reporterId String
  reporter   User   @relation("ReportedIssues", fields: [reporterId], references: [id])

  // Görevin atandığı kişi (opsiyonel, atanmamış olabilir)
  assigneeId String?
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id])

  @@unique([projectId, number])
}

// Projedeki kullanıcı rolleri
enum Role {
  OWNER
  ADMIN // Projeyi yönetebilir, üye ekleyip çıkarabilir
  MEMBER // Görev oluşturabilir, görevleri yönetebilir
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// Bir görevin durumu (Kanban board için)
enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// Bir görevin öncelik seviyesi
enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  HIGHEST
}
